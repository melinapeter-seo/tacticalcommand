---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Scroller from '../../components/Scroller.astro';
import SizeCalc from '../../components/SizeCalc.astro';
import { productos, categoriaDeProducto, guias, money, relacionados, tarjeta, WA, type Producto, type TarjetaVista } from '../../lib/data';
import { fotosVista } from '../../lib/fotos';
import { graph, breadcrumbs, faqPage, abs, cap, desc, ORG_ID } from '../../lib/seo';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Producto };
const cat = categoriaDeProducto(p);
const path = `/productos/${p.slug}/`;
const o = p.opciones;
const app = o.es_indumentaria;
const nombre = p.nombre;
const h1 = p.titulo.join(' ');
const multi = p.colores.length > 1;
const sizeCalc = o.con_talles && !o.es_calzado;
const hasKeys = p.caracteristicas.length > 0;
const keysD = hasKeys && !o.es_calzado;

// Datos por color para el script de la ficha (fotos optimizadas, talles, SKU).
const colores = await Promise.all(p.colores.map(async (c) => ({
  n: c.nombre, sku: c.sku, sw: c.muestra, talles: c.talles.map((t) => t.talle), fotos: await fotosVista(c.fotos),
})));
const c0 = colores[0];
const tallesMax = c0.talles;
const nT = Math.max(c0.fotos.length - 1, 1);
const sizeColD = o.columnas_talle || 6;
const sizeColM = c0.talles.length % 4 === 0 ? 4 : 3;

const waAsk = (cn: string, sku: string) => WA(`Hola Walter! Quiero consultar por ${nombre}${multi || app ? `, color ${cn.toLowerCase()}` : ''} (SKU ${sku}). ¿Tienen disponibilidad y precio?`);
const waSpec = WA(`Hola Tactical Command! Quiero consultar disponibilidad de ${nombre} en color ${c0.n.toLowerCase()}.`);

const funcHead = p.funciones[0];
const funcRest = p.funciones.slice(1);
const fl = p.funciones.length;
const pfCols = fl % 4 === 0 ? 'repeat(4,minmax(0,1fr))' : fl % 3 === 0 ? 'repeat(3,minmax(0,1fr))' : 'minmax(0,1.25fr) repeat(3,minmax(0,1fr))';
const pfHeadRow = fl % 4 !== 0 && fl % 3 !== 0 ? 'span 2' : 'auto';
const dist = p.distribucion;
const distCols = !p.beneficios.length && dist ? `repeat(${Math.min(3, Math.max(2, Math.ceil(dist.items.length / 2)))},minmax(0,1fr))` : '1fr';
const nav = [
  ['DESCRIPCIÓN', 'pdp-desc', true], ['CARACTERÍSTICAS', 'pdp-func', fl > 0], ['MEDIDAS Y USOS', 'pdp-dims', p.medidas.length > 0],
  [dist?.titulo || 'DISTRIBUCIÓN Y USOS', 'pdp-dist', !!dist], ['ESPECIFICACIONES', 'pdp-specs', true], ['PREGUNTAS FRECUENTES', 'pdp-faq', p.faq.length > 0],
].filter((x) => x[2]) as [string, string, boolean][];
const longLead = p.descripcion_larga[0] || p.descripcion;
const longRest = p.descripcion_larga.slice(1);
const rel = relacionados(p).map(tarjeta).filter(Boolean) as TarjetaVista[];
const guia = p.guia && guias.find((g) => `/guias/${g.slug}/` === p.guia!.url);
const hoy = new Date();
const actualizado = (p as any).actualizado ? new Date((p as any).actualizado) : hoy;
const fecha = actualizado.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });

// JSON-LD: ProductGroup con una variante (Product + Offer) por color.
const validUntil = new Date(hoy.getFullYear(), hoy.getMonth() + 3, 0).toISOString().slice(0, 10);
const offer = (sku: string) => ({
  '@type': 'Offer', price: p.precio_minorista, priceCurrency: 'ARS', availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition',
  priceValidUntil: validUntil, url: abs(path), seller: { '@id': ORG_ID },
  shippingDetails: { '@type': 'OfferShippingDetails', shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'AR' }, deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 3, unitCode: 'DAY' } }, shippingRate: { '@type': 'MonetaryAmount', currency: 'ARS', description: 'A cargo del comprador; se cotiza por WhatsApp' } },
  hasMerchantReturnPolicy: { '@type': 'MerchantReturnPolicy', applicableCountry: 'AR', returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow', merchantReturnDays: 10, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/FreeReturn', merchantReturnLink: abs('/arrepentimiento/') },
  ...(sku ? { sku } : {}),
});
const props = p.especificaciones.filter((s) => !/confirmar/i.test(s.v)).map((s) => ({ '@type': 'PropertyValue', name: cap(s.k), value: s.v }));
const material = p.especificaciones.find((s) => /^(MATERIAL|TELA|MATERIALES)/.test(s.k))?.v;
const jsonld = graph(
  {
    '@type': 'ProductGroup', '@id': abs(path) + '#producto', name: nombre, description: p.descripcion, url: abs(path), productGroupID: p.sku,
    brand: { '@type': 'Brand', name: 'Tactical Command' }, category: `${cap(p.categoria)} > ${cap(p.subcategoria)}`, ...(material ? { material } : {}),
    variesBy: [multi && 'https://schema.org/color', o.con_talles && 'https://schema.org/size'].filter(Boolean),
    image: colores.flatMap((c) => c.fotos.map((f) => abs(f.full))).slice(0, 10),
    additionalProperty: props,
    hasVariant: colores.map((c) => ({
      '@type': 'Product', name: multi ? `${nombre} ${cap(c.n)}` : nombre, sku: c.sku, color: cap(c.n), url: abs(path) + (multi ? `?color=${encodeURIComponent(c.n)}` : ''),
      image: c.fotos.map((f) => abs(f.full)), ...(c.talles.length ? { size: c.talles.join(', ') } : {}), offers: offer(c.sku),
    })),
  },
  breadcrumbs([['Inicio', '/'], [cap(cat.titulo), `/${cat.slug}/`], [nombre, path]]),
  faqPage(p.faq),
);
const title = p.seo.titulo ? `${p.seo.titulo} | Tactical Command` : `${nombre} | Tactical Command`;
const description = desc(p.seo.descripcion || p.descripcion);
const lcp = c0.fotos[0];
const data = { slug: p.slug, nombre, multi, app, conTalles: o.con_talles, precio: p.precio_minorista, provisorio: p.precio_provisorio, colores, waNum: '5493492649494' };
---
<Base title={title} description={description} path={path} ogType="product" ogImage={lcp?.full} jsonld={jsonld} lcp={lcp ? { srcset: lcp.srcset, sizes: '(min-width: 1024px) 40vw, 100vw', type: 'image/webp' } : null}>
  <article class:list={['pdp', app ? 'app' : 'std', { shoe: o.es_calzado }]} itemscope>
    <div class="hero" style={`--nT:${nT};--scd:${sizeColD};--scm:${sizeColM}`}>
      <div class="gal" id="gal" data-n={c0.fotos.length}>
        <div class="gal-items" id="gal-items" data-noscrollbar>
          {c0.fotos.length ? c0.fotos.map((f, i) => (
            <button type="button" class:list={['gi', { main: i === 0 }]} data-i={i} aria-label={i === 0 ? `Ampliar foto de ${nombre}` : `Ver foto ${i + 1} de ${nombre}`}>
              <img src={f.src} srcset={f.srcset} sizes={i === 0 ? '(min-width: 1024px) 40vw, 100vw' : '(min-width: 1024px) 120px, 100vw'} width={f.w} height={f.h} alt={`${nombre} ${multi ? cap(c0.n) + ', ' : ''}vista ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding={i === 0 ? 'sync' : 'async'} />
              <img src="/escudo-tc-wm.webp" alt="" aria-hidden="true" class="wm" width="300" height="300" loading="lazy" />
            </button>
          )) : (
            <div class="gi main ph"><span>IMAGEN PENDIENTE<br />{nombre.toUpperCase()}</span></div>
          )}
        </div>
        <div class="gal-count d-only" aria-hidden="true"><span id="gal-count">01 / {String(c0.fotos.length).padStart(2, '0')}</span>{app && <><span class="dot">·</span><span data-color-name>{c0.n}</span></>}</div>
        <span class="gal-zoom d-only" aria-hidden="true"><span>⤢</span>AMPLIAR</span>
        <div class="m-count m-only" aria-hidden="true" id="m-count">01 / {String(c0.fotos.length).padStart(2, '0')}</div>
        <div class="m-zoom m-only" aria-hidden="true">⤢</div>
        <div class="m-dots m-only" aria-hidden="true" id="m-dots">{c0.fotos.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}</div>
      </div>

      <div class="info">
        <div class="eyebrow">
          <nav aria-label="Migas de pan" class="bc-ey">
            <ol>
              <li class="d-only"><a href={`/${cat.slug}/`}>{p.categoria}</a></li>
              <li>{p.subcategoria}</li>
            </ol>
          </nav>
          <span class="sku"><span class="d-only">SKU / </span><span data-sku>{c0.sku}</span></span>
        </div>
        <h1 class:list={['h1', { nw: !app && h1.length <= 26 }]}>{h1}</h1>
        <p class="lead d-std">{p.descripcion}</p>
        <div class="price price-top"><data value={p.precio_minorista}>{money(p.precio_minorista)}</data></div>
        <div class="hr hr-a"></div>

        {(multi || app) && (
          <div class="colors">
            <div class="row-l"><span>COLOR</span><span data-color-name class="cn">{c0.n}</span></div>
            <div class="sw-list" role="radiogroup" aria-label="Color">
              {colores.map((c, i) => (
                <button type="button" class="sw" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-color={c.n} aria-label={c.n}>
                  <span class="sw-c" style={`background:${c.sw}`}></span><span class="sw-n">{c.n}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {o.con_talles && (
          <div class="sizes">
            <div class="row-l sz-head"><span>TALLE</span>{sizeCalc && <button type="button" class="calc calc-top" data-open-calc><span class="d-only">CALCULÁ TU TALLE IDEAL →</span><span class="m-only">GUÍA DE TALLES →</span></button>}</div>
            <div class="sz-grid" role="radiogroup" aria-label="Talle" id="sz-grid">
              {tallesMax.map((t) => <button type="button" class="sz" role="radio" aria-checked="false" data-talle={t} title={`Talle ${t}`}>{t}</button>)}
            </div>
            <div class="sz-state-row">
              <span class="sz-state" id="sz-state" aria-live="polite">SELECCIONAR TALLE</span>
              {sizeCalc && <button type="button" class="calc calc-bot" data-open-calc>CALCULÁ TU TALLE IDEAL →</button>}
            </div>
            {o.nota_talle && <div class="sz-note">{o.nota_talle}</div>}
            {o.consulta_whatsapp_talle && (
              <div class="wa-note d-std"><span>¿No encontrás tu talle o color?</span><a href={waSpec} target="_blank" rel="noopener" data-wa="talle" id="wa-spec">CONSULTANOS POR WHATSAPP →</a></div>
            )}
          </div>
        )}

        <div class="hr hr-b d-std"></div>
        <div class="price price-bot d-std"><data value={p.precio_minorista}>{money(p.precio_minorista)}</data></div>

        <button type="button" class="btn-gold anim cta" data-add>AGREGAR AL CARRITO</button>
        <a href={waAsk(c0.n, c0.sku)} target="_blank" rel="noopener" class="wa-ask" data-wa="ficha" id="wa-ask">CONSULTAR POR WHATSAPP</a>
        <a href="/mayoristas/" class="ws-link"><span class="t">¿Comprás 8 unidades o más?</span><span class="g">COTIZÁ POR MAYOR →</span></a>
        {hasKeys && (
          <ul class:list={['keys', { 'no-d': !keysD }]}>
            {p.caracteristicas.map((k) => <li><span class="dia" aria-hidden="true"></span>{k}</li>)}
          </ul>
        )}
        <a href="#pdp-desc" class="more"><span>CONOCÉ MÁS SOBRE ESTE PRODUCTO</span><span class="ar" aria-hidden="true">↓</span></a>
      </div>
    </div>

    <nav class="pnav" aria-label="Secciones de la ficha" data-noscrollbar>
      {nav.map(([t, id], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{t}</a>)}
    </nav>

    <section id="pdp-desc" class="desc" aria-labelledby="desc-h">
      <h2 id="desc-h" class="h2 m-only-h">DESCRIPCIÓN</h2>
      {p.descripcion_larga.length ? (
        <div class="desc-grid">
          <p class="desc-lead">{longLead}</p>
          <div class="desc-rest" id="desc-rest">{longRest.map((t) => <p>{t}</p>)}</div>
        </div>
      ) : (
        <p class="desc-p0">{p.descripcion}</p>
      )}
      {longRest.length > 0 && <button type="button" class="desc-tg m-only" id="desc-tg" aria-expanded="false" aria-controls="desc-rest">LEER DESCRIPCIÓN COMPLETA +</button>}
    </section>

    {fl > 0 && (
      <section id="pdp-func" class="sec func" aria-labelledby="func-h">
        <h2 id="func-h" class="h2 sec-h">PENSADA PARA EL TERRENO</h2>
        <div class="pf d-only" style={`grid-template-columns:${pfCols}`}>
          <div class="pf-head" style={`grid-row:${pfHeadRow}`}>
            <div class="pf-top"><h3 class="pf-k">{funcHead.titulo}</h3><span class="pf-n">01</span></div>
            <div>
              {p.cifra_destacada && <div class="pf-big">{p.cifra_destacada}</div>}
              {funcHead.destacado && p.cifra_destacada && <div class="pf-sm">{funcHead.destacado}</div>}
              {funcHead.destacado && !p.cifra_destacada && <><div class="pf-line"></div><div class="pf-bigs">{funcHead.destacado}</div></>}
              <p class="pf-v">{funcHead.texto}</p>
            </div>
          </div>
          {funcRest.map((x, i) => (
            <div class="pf-c">
              <div class="pf-top"><h3 class="pf-k">{x.titulo}</h3><span class="pf-n">{String(i + 2).padStart(2, '0')}</span></div>
              {x.destacado && <div class="pf-s">{x.destacado}</div>}
              <p class="pf-t">{x.texto}</p>
            </div>
          ))}
        </div>
        <div class="pf-m m-only" data-noscrollbar aria-hidden="true">
          {p.funciones.map((x, i) => (
            <div class="pf-mc">
              <div class="pf-mn">{String(i + 1).padStart(2, '0')}</div>
              <div class="pf-mk">{x.titulo}</div>
              {x.destacado && <div class="pf-ms">{x.destacado}</div>}
              <p>{x.texto}</p>
            </div>
          ))}
        </div>
        <div class="pf-hint m-only" aria-hidden="true">DESLIZÁ PARA VER LAS {fl} →</div>
      </section>
    )}

    {p.medidas.length > 0 && (
      <section id="pdp-dims" class="sec" aria-labelledby="dims-h">
        <h2 id="dims-h" class="h2 dims-h">LISTA PARA SALIR</h2>
        <div class="pd-grid">
          <div>
            <div class="lbl">DIMENSIONES</div>
            <dl class="dims">
              {p.medidas.map((d) => <div><dd><span class="v">{d.valor}</span><span class="u">cm</span></dd><dt>{d.etiqueta}</dt></div>)}
            </dl>
            <div class="note">{p.medidas_nota || 'MEDIDAS APROXIMADAS'}</div>
          </div>
          <div class="pd-r">
            <div>
              <div class="lbl">USOS INDICADOS</div>
              {p.usos_detalle.length ? (
                <dl class="uses-d">{p.usos_detalle.map((u) => <div><dt>{u.titulo}</dt><dd>{u.texto}</dd></div>)}</dl>
              ) : (
                <ul class="chips">{p.usos.map((u) => <li>{u}</li>)}</ul>
              )}
            </div>
            {p.incluye && <div class="incl"><span>INCLUYE</span><span>{p.incluye}</span></div>}
          </div>
        </div>
      </section>
    )}

    {dist && (
      <section id="pdp-dist" class="sec" aria-labelledby="dist-h">
        <h2 id="dist-h" class="h2 sec-h">{dist.titulo || 'DISTRIBUCIÓN Y USOS'}</h2>
        <div class:list={['dist-grid', { 'has-ben': p.beneficios.length > 0 }]}>
          <div>
            <div class="lbl">{dist.etiqueta || 'DISTRIBUCIÓN FUNCIONAL'}</div>
            <ol class="dist" style={`--dc:${distCols}`}>
              {dist.items.map((d, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{d.titulo}</h3><p>{d.texto}</p></div></li>)}
            </ol>
          </div>
          {(p.beneficios.length > 0 || !p.medidas.length) && (
            <div class="dist-r">
              {!p.medidas.length && p.usos.length > 0 && (
                <div><div class="lbl">USOS INDICADOS</div><ul class="chips">{p.usos.map((u) => <li>{u}</li>)}</ul></div>
              )}
              {p.beneficios.length > 0 && (
                <div>
                  <div class="lbl">BENEFICIOS PRINCIPALES</div>
                  <ul class="ben">{p.beneficios.map((b, i, a) => <li style={a.length % 2 && i === a.length - 1 ? 'grid-column:1 / -1' : ''}><h3>{b.titulo}</h3><p>{b.texto}</p></li>)}</ul>
                </div>
              )}
            </div>
          )}
        </div>
      </section>
    )}

    <section id="pdp-specs" class="sec specs-sec" aria-labelledby="specs-h">
      <div class="specs-in">
        <h2 id="specs-h" class="h2">ESPECIFICACIONES</h2>
        <dl class="specs" id="specs">
          {p.especificaciones.map((s, i) => <div class:list={{ extra: i >= 8 }}><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
        </dl>
        {p.especificaciones.length > 8 && <button type="button" class="specs-tg m-only" id="specs-tg" aria-expanded="false">VER TODAS LAS ESPECIFICACIONES ({p.especificaciones.length}) +</button>}
        <p class="upd">ACTUALIZADO EL <time datetime={actualizado.toISOString().slice(0, 10)}>{fecha}</time></p>
      </div>
    </section>

    {p.faq.length > 0 && (
      <section id="pdp-faq" class="sec specs-sec" aria-labelledby="faq-h">
        <div class="specs-in">
          <h2 id="faq-h" class="h2 faq-h"><span class="d-only">TODO LO QUE NECESITÁS SABER</span><span class="m-only">TODO LO QUE<br />NECESITÁS SABER</span></h2>
          <div class="qa">
            {p.faq.map((x) => (
              <details>
                <summary><h3>{x.q}</h3><span aria-hidden="true">+</span></summary>
                <p>{x.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {guia && (
      <aside class="sec guia" aria-label="Guía relacionada">
        <a href={`/guias/${guia.slug}/`} class="guia-a">
          <span class="m">GUÍA RELACIONADA · {guia.lectura}</span>
          <span class="t">{guia.titulo}</span>
          <span class="go">LEER GUÍA →</span>
        </a>
        <a href={`/${cat.slug}/`} class="guia-cat">VER TODA LA CATEGORÍA {cat.titulo} →</a>
      </aside>
    )}

    <aside class="sec rel" aria-labelledby="rel-h">
      <h2 id="rel-h" class="h2 rel-h">COMPLETÁ EL EQUIPO</h2>
      <div class="rel-body">
        <Scroller name="pdpRel" label="Productos para completar el equipo">
          {rel.map((t) => <ProductCard t={t} class="rel-card" sizes="(min-width: 1024px) 26vw, 70vw" mobileCta={false} />)}
        </Scroller>
      </div>
    </aside>
  </article>

  <div class="sticky m-only" id="sticky" hidden>
    <div class="st-l"><div class="st-p">{money(p.precio_minorista)}</div><div class="st-s" id="st-s">{c0.n}{o.con_talles ? ' · SELECCIONAR TALLE' : ''}</div></div>
    <button type="button" class="btn-gold anim st-b" data-add>COMPRAR</button>
  </div>

  {sizeCalc && <SizeCalc nombre={nombre} />}
  <script type="application/json" id="pdp-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import '../../scripts/pdp.ts';
</script>

<style>
  .pdp { --galH: clamp(560px, calc(100vh / var(--z) - 190px), 800px); }
  .hero { padding: 24px 40px 0; display: grid; grid-template-columns: auto minmax(0, 700px); gap: 80px; align-items: stretch; justify-content: center; }
  .app .hero { grid-template-columns: auto minmax(380px, 480px); gap: 64px; }

  /* Galería: en desktop miniaturas + principal; en mobile, carrusel con todas las fotos. */
  .gal { position: relative; align-self: start; height: var(--galH); }
  .gal-items { --tw: calc((var(--galH) - 40px) / 5); display: grid; grid-template-columns: var(--tw) var(--galH); grid-template-rows: repeat(var(--nT), var(--tw)); gap: 10px 12px; height: 100%; }
  .gal[data-n='7'] .gal-items, .gal[data-n='8'] .gal-items, .gal[data-n='9'] .gal-items, .gal[data-n='10'] .gal-items { --tw: calc((var(--galH) - 10px * (var(--nT) - 1)) / var(--nT)); }
  .gi { position: relative; padding: 0; border: 1px solid var(--border); background: var(--bg); overflow: hidden; cursor: pointer; grid-column: 1; aspect-ratio: 1 / 1; opacity: .78; transition: border-color .25s, opacity .25s; }
  .gi:hover { border-color: var(--gold); opacity: 1; }
  .gi img:first-child { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gi .wm { display: none; }
  .gi.main { grid-column: 2; grid-row: 1 / -1; height: var(--galH); width: var(--galH); opacity: 1; cursor: zoom-in; background: #151715; border-color: #1C211C; }
  .gi.main img:first-child { animation: fade .6s both; }
  .gi.main .wm, .gi .wm { position: absolute; left: 3%; bottom: 3%; width: 30%; height: auto; opacity: .32; pointer-events: none; filter: grayscale(.2); }
  .gi.main .wm { display: block; }
  .gi.ph { display: flex; align-items: center; justify-content: center; cursor: default; }
