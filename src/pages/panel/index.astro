---
// Panel de gestión de Walter (isla React). Privado: noindex, fuera del sitemap y bloqueado en robots.txt.
import App from '../../panel/App';
import '../../panel/panel.css';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F5F5F2" />
    <title>Panel · Tactical Command</title>
    <!-- Vista previa al compartir el link (WhatsApp): el panel es privado, no se indexa. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Panel de Tactical Command" />
    <meta property="og:description" content="Acceso privado para gestionar pedidos, clientes, productos y precios de la tienda." />
    <meta property="og:url" content="https://tacticalcommand.com.ar/panel/" />
    <meta property="og:image" content="https://tacticalcommand.com.ar/og/panel.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tactical Command" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/inter-tight-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
