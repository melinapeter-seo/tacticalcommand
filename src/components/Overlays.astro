---
import { NAV, indiceBusqueda } from '../lib/data';
const idx = indiceBusqueda();
const x = `<svg viewBox="0 0 24 24" fill="none" stroke="#E3B23C" stroke-width="2" stroke-linecap="round" style="width:8px;height:8px" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>`;
---
<div id="menu" class="ov ov-menu" hidden>
  <button type="button" class="x-round" data-close aria-label="Cerrar menú"><Fragment set:html={x} /></button>
  <nav aria-label="Menú mobile" class="mn">
    <a href="/mayoristas/" class="mn-ws"><span class="gold-text">MAYORISTAS</span><span class="mono" aria-hidden="true">→</span></a>
    <div class="mn-h pulse">CATEGORÍAS</div>
    {NAV.slice(0, 4).map((it) => <a href={it.url} class="mn-cat">{it.t}</a>)}
    {NAV.slice(4).map((it) => <a href={it.url} class="mn-rest">{it.t}</a>)}
  </nav>
</div>

<div id="search" class="ov ov-search" hidden role="dialog" aria-modal="true" aria-label="Buscar en el catálogo">
  <div class="sr-in">
    <div class="sr-top d-only"><span>SEARCH / CATÁLOGO</span><button type="button" data-close>CERRAR ✕</button></div>
    <div class="sr-top-m m-only"><button type="button" class="x-round" data-close aria-label="Cerrar búsqueda"><Fragment set:html={x} /></button></div>
    <label for="q" class="sr-only">Buscar producto, categoría o término técnico</label>
    <input id="q" type="search" autocomplete="off" class="sr-q" placeholder="Buscar producto, categoría o término técnico" />
    <div class="sr-lbl" id="sr-lbl">SUGERENCIAS</div>
    <div class="sr-res" id="sr-res" aria-live="polite"></div>
  </div>
  <script type="application/json" id="sr-idx" set:html={JSON.stringify(idx)} />
</div>

<div id="cart" class="ov ov-cart" hidden role="dialog" aria-modal="true" aria-label="Carrito">
  <div class="dr" data-stop>
    <div class="dr-top"><span>CARRITO / <span data-cart-count>0</span> ÍTEMS</span><button type="button" data-close>CERRAR ✕</button></div>
    <div class="dr-list" id="cart-list"></div>
    <div class="dr-foot">
      <div class="dr-row"><span style="color:#9AA09A">SUBTOTAL</span><span id="cart-total">A CONFIRMAR</span></div>
      <div class="dr-row dr-ship"><span>ENVÍO</span><span class="dr-ship-v"><span style="color:#C3C8C1">A CARGO DEL COMPRADOR</span><span>SE COTIZA POR WHATSAPP</span></span></div>
      <div id="cart-cta" hidden>
        <a id="cart-wa" href="#" target="_blank" rel="noopener" class="btn-gold anim dr-wa" data-wa="carrito">ENVIAR PEDIDO POR WHATSAPP →</a>
        <div class="dr-how">
          <div class="dr-how-h">CÓMO SIGUE</div>
          <div class="dr-step"><span>01</span>Enviás tu pedido por WhatsApp, ya armado.</div>
          <div class="dr-step"><span>02</span>Te confirmamos el stock de cada producto.</div>
          <div class="dr-step"><span>03</span>Coordinamos juntos el pago y el envío.</div>
          <div class="dr-note">Hasta confirmar, no pagás nada.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="lb" class="ov ov-lb" hidden role="dialog" aria-modal="true" aria-label="Visor de fotos">
  <div class="lb-fig" data-stop>
    <img id="lb-img" alt="" />
    <img src="/escudo-tc-wm.webp" alt="" aria-hidden="true" class="lb-wm" loading="lazy" width="240" height="303" />
  </div>
  <button type="button" class="lb-btn lb-x" data-close aria-label="Cerrar">✕</button>
  <button type="button" class="lb-btn lb-arr lb-prev" id="lb-prev" aria-label="Foto anterior">←</button>
  <button type="button" class="lb-btn lb-arr lb-next" id="lb-next" aria-label="Foto siguiente">→</button>
  <div class="lb-count" id="lb-count"></div>
</div>

<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

<style>
  .ov[hidden] { display: none !important; }
  .x-round { width: 13px; height: 13px; flex: none; border-radius: 50%; border: 1px solid var(--gold); background: rgba(227,178,60,.06); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; box-shadow: 0 0 14px rgba(227,178,60,.25); }
  .x-round::before { content: ''; position: absolute; width: 44px; height: 44px; }
  .ov-menu { position: fixed; inset: 0; z-index: 90; background: var(--bg); animation: fade .3s var(--ease) both; display: flex; flex-direction: column; padding: 18px; overflow-y: auto; }
  .ov-menu > .x-round { align-self: flex-end; position: relative; }
  .mn { margin-top: 20px; display: flex; flex-direction: column; }
  .mn-ws { display: flex; align-items: center; justify-content: space-between; padding: 18px 16px; margin-bottom: 22px; border: 1px solid var(--gold); background: rgba(227,178,60,.08); box-shadow: 0 0 28px rgba(227,178,60,.22); }
  .mn-ws .gold-text { font-size: 23px; font-weight: 600; letter-spacing: .02em; }
  .mn-ws .mono { font-size: 14px; color: var(--gold); }
  .mn-h { font-family: var(--mono); font-size: 10px; letter-spacing: .24em; color: var(--gold); padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .mn-cat { display: flex; padding: 17px 0 17px 16px; border-bottom: 1px solid var(--surface); font-size: 23px; font-weight: 500; letter-spacing: -.01em; }
  .mn-rest { display: flex; padding: 20px 0; border-bottom: 1px solid var(--border); font-size: 27px; font-weight: 500; letter-spacing: -.01em; color: var(--gold); }

  .ov-search { position: fixed; inset: 0; z-index: 95; background: rgba(26,29,27,.97); backdrop-filter: blur(8px); animation: fade .25s var(--ease) both; padding: 0 var(--pad); overflow-y: auto; }
  .sr-in { max-width: 980px; margin: 0 auto; padding-top: 96px; padding-bottom: 40px; }
  .sr-top { display: flex; align-items: center; justify-content: space-between; font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--faint); }
  .sr-top button { background: none; border: 0; cursor: pointer; font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--muted); }
  .sr-top-m { display: flex; justify-content: flex-end; }
  .sr-top-m .x-round { position: relative; }
  .sr-q { width: 100%; margin-top: 26px; background: none; border: 0; border-bottom: 1px solid var(--border); padding: 18px 0; font-size: 38px; font-weight: 400; letter-spacing: -.02em; outline: none; border-radius: 0; -webkit-appearance: none; appearance: none; }
  .sr-q:focus-visible { border-bottom-color: var(--gold); }
  .sr-lbl { font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--faint); margin: 30px 0 14px; }
  .sr-res { display: flex; flex-direction: column; }
  .sr-res :global(a) { display: flex; align-items: center; gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--surface); }
  .sr-res :global(.k) { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; color: var(--faint); width: 132px; flex: none; }
  .sr-res :global(.t) { font-size: 17px; font-weight: 400; }
  .sr-res :global(.a) { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--gold); animation: goldpulse 4.5s ease-in-out infinite; }
  @media (max-width: 1023px) { .sr-in { padding-top: 18px; } .sr-q { margin-top: 20px; font-size: 22px; } .sr-res :global(.k) { width: 96px; } }

  .ov-cart { position: fixed; inset: 0; z-index: 95; background: rgba(0,0,0,.55); animation: fade .25s both; }
  .dr { position: absolute; top: 0; right: 0; bottom: 0; width: 460px; max-width: 100%; background: var(--bg); border-left: 1px solid var(--border); animation: drawer .42s var(--ease) both; display: flex; flex-direction: column; }
  @media (max-width: 1023px) { .dr { width: 100%; } }
  .dr-top { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--faint); }
  .dr-top button { background: none; border: 0; cursor: pointer; font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--muted); }
  .dr-list { flex: 1; overflow-y: auto; padding: 0 24px; }
  .dr-list :global(.empty) { padding: 60px 0; font-family: var(--mono); font-size: 11px; letter-spacing: .16em; color: var(--muted-2); line-height: 2; }
  .dr-list :global(.it) { display: flex; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--surface); }
  .dr-list :global(.it img) { width: 76px; height: 96px; flex: none; object-fit: cover; background: var(--surface); }
  .dr-list :global(.it .b) { flex: 1; min-width: 0; }
  .dr-list :global(.sku) { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; color: var(--faint); }
  .dr-list :global(.n) { font-size: 15px; font-weight: 500; margin-top: 6px; line-height: 1.25; }
  .dr-list :global(.v) { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; color: var(--muted); margin-top: 6px; }
  .dr-list :global(.r) { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; }
  .dr-list :global(.q) { font-family: var(--mono); font-size: 11px; color: var(--text); }
  .dr-list :global(.rm) { background: none; border: 0; cursor: pointer; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; color: var(--muted-2); }
  .dr-list :global(.rm:hover) { color: var(--gold); }
  .dr-foot { border-top: 1px solid var(--border); padding: 22px 24px; display: flex; flex-direction: column; gap: 16px; }
  .dr-row { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; }
  .dr-ship { font-size: 10px; color: var(--muted-2); }
  .dr-ship-v { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; text-align: right; }
  #cart-cta:not([hidden]) { display: flex; flex-direction: column; gap: 16px; }
  .dr-wa { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 19px; letter-spacing: .18em; }
  .dr-how { display: flex; flex-direction: column; gap: 10px; }
  .dr-how-h { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; color: var(--faint); }
  .dr-step { display: flex; gap: 12px; font-size: 13px; line-height: 1.5; color: var(--text-2); }
  .dr-step span { flex: none; font-family: var(--mono); color: var(--gold); }
  .dr-note { font-size: 12px; line-height: 1.5; color: var(--muted-2); margin-top: 2px; }

  .ov-lb { position: fixed; inset: 0; z-index: 140; background: rgba(5,6,5,.96); display: flex; align-items: center; justify-content: center; animation: fade .25s both; }
  .lb-fig { position: relative; display: inline-block; line-height: 0; max-width: 100vw; max-height: 100vh; }
  .lb-fig #lb-img { max-width: calc(100vw / var(--z)); max-height: calc(100vh / var(--z)); width: auto; height: auto; object-fit: contain; display: block; }
  .lb-wm { position: absolute; left: 3%; bottom: 3%; width: 30%; height: auto; opacity: .32; pointer-events: none; filter: grayscale(.2); }
  .lb-btn { position: absolute; z-index: 3; border-radius: 50%; border: 1px solid rgba(227,178,60,.55); background: rgba(26,29,27,.72); color: var(--gold); font-size: 20px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .lb-btn:hover { background: var(--gold); color: var(--ink); }
  .lb-x { top: 24px; right: 24px; width: 48px; height: 48px; }
  .lb-arr { top: 50%; transform: translateY(-50%); width: 56px; height: 56px; z-index: 2; }
  .lb-prev { left: 28px; } .lb-next { right: 28px; }
  .lb-count { position: absolute; left: 0; right: 0; bottom: 28px; text-align: center; font-family: var(--mono); font-size: 12px; letter-spacing: .2em; color: var(--text); text-shadow: 0 0 8px rgba(0,0,0,.9); pointer-events: none; }
  @media (max-width: 1023px) { .lb-x { top: 12px; right: 12px; } .lb-arr { width: 44px; height: 44px; } .lb-prev { left: 8px; } .lb-next { right: 8px; } .lb-count { bottom: 20px; } }

  .toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: 34px; z-index: 99; background: var(--surface); border: 1px solid var(--border); border-left: 2px solid var(--gold); padding: 16px 22px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; animation: rise .35s var(--ease) both; max-width: 88vw; }
  .toast[hidden] { display: none; }
</style>
