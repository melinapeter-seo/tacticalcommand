---
// Migas de pan visibles (requisito SEO del handoff). El JSON-LD BreadcrumbList va en cada página.
interface Props { items: [string, string][]; light?: boolean; class?: string }
const { items, light = false, class: cls = '' } = Astro.props;
---
<nav aria-label="Migas de pan" class:list={['bc', cls, { light }]}>
  <ol>
    {items.map(([t, u], i) => (
      <li>
        {i < items.length - 1 ? <a href={u}>{t}</a> : <span aria-current="page">{t}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .bc ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .bc li { display: flex; align-items: center; gap: 10px; }
  .bc li + li::before { content: '/'; color: var(--faint); }
  .bc a { color: var(--muted); }
  .bc a:hover { color: var(--gold); }
  .bc span { color: var(--faint); }
  .bc.light a { color: var(--text-2); }
  .bc.light span { color: var(--muted); }
  @media (max-width: 1023px) { .bc ol { font-size: 10px; } }
</style>
