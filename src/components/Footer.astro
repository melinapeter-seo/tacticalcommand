---
import { Image } from 'astro:assets';
import Social from './Social.astro';
import { FOOTER } from '../lib/data';
import { img } from '../lib/img';
interface Props { extraPb?: boolean }
const { extraPb = false } = Astro.props;
const logo = (await img('logo-tc.webp'))!;
const DEFENSA = 'https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario';
---
<footer class="ft" class:list={{ 'ft-ws': extraPb }}>
  <div class="ft-soc">
    <div class="ft-soc-in">
      <span class="ft-seg">SEGUINOS</span>
      <div class="ft-icons">
        <Social size={44} filter="drop-shadow(0 0 8px rgba(227,178,60,.6)) drop-shadow(0 0 3px rgba(255,214,110,.5))" linkClass="ft-ic" />
      </div>
    </div>
  </div>
  <div class="ft-body">
    <div class="ft-grid d-only">
      <div class="ft-brand">
        <div class="ft-brand-in">
          <div class="ft-name gold-text">TACTICAL COMMAND</div>
          <div class="ft-tag"><span>RAFAELA</span><span>—</span><span>SANTA</span><span>FE</span><span>—</span><span>ARGENTINA</span></div>
          <div class="ft-logo"><Image src={logo} alt="Escudo de Tactical Command" width={380} height={380} loading="lazy" /></div>
        </div>
      </div>
      {FOOTER.map((f) => (
        <div class="ft-col">
          <div class="ft-h">{f.t}</div>
          <div class="ft-links">
            {f.links.map((l: any) => <a href={l.url}>{(f.legal && l.corto) || l.t}</a>)}
          </div>
        </div>
      ))}
    </div>
    <div class="ft-bar d-only">
      <p>Defensa al Consumidor. Para reclamos <a href={DEFENSA} target="_blank" rel="noopener">ingrese aquí</a>.</p>
      <a href="/arrepentimiento/" class="ft-arr">BOTÓN DE ARREPENTIMIENTO</a>
    </div>

    <div class="m-only">
      <div class="ft-mtop">
        <div class="ft-logo ft-logo-m"><Image src={logo} alt="Escudo de Tactical Command" width={256} height={256} loading="lazy" /></div>
        <div class="ft-brand-in">
          <div class="ft-name gold-text">TACTICAL COMMAND</div>
          <div class="ft-tag"><span>RAFAELA</span><span>—</span><span>SANTA</span><span>FE</span><span>—</span><span>ARGENTINA</span></div>
        </div>
      </div>
      <div class="ft-acc">
        {FOOTER.map((f) => (
          <details>
            <summary>{f.t}<span aria-hidden="true">+</span></summary>
            <div class="ft-acc-links">{f.links.map((l: any) => <a href={l.url}>{l.t}</a>)}</div>
          </details>
        ))}
      </div>
      <a href="/arrepentimiento/" class="ft-arr ft-arr-m">BOTÓN DE ARREPENTIMIENTO</a>
      <p class="ft-def-m">Defensa al Consumidor.<br />Para reclamos <a href={DEFENSA} target="_blank" rel="noopener">ingrese aquí</a>.</p>
    </div>

    <div class="ft-copy"><span>TACTICAL COMMAND © 2026<br />TODOS LOS DERECHOS RESERVADOS</span></div>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--border); background: var(--bg); padding-bottom: 60px; }
  .ft.ft-ws { padding-bottom: 130px; }
  .ft-soc { border-bottom: 1px solid var(--border); background: var(--surface-2); padding: 18px var(--pad); }
  .ft-soc-in { max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: flex-end; gap: 10px 18px; flex-wrap: wrap; }
  .ft-seg { font-family: var(--mono); font-size: 16px; letter-spacing: .22em; font-weight: 500; color: var(--gold); }
  .ft-icons { display: flex; align-items: center; gap: 14px; }
  .ft-icons :global(.ft-ic) { width: 44px; justify-content: center; transition: transform .2s; }
  .ft-icons :global(.ft-ic img) { height: 30px !important; }
  .ft-icons :global(.ft-ic[aria-label='WhatsApp'] img) { height: 24px !important; }
  .ft-icons :global(.ft-ic:hover) { transform: translateY(-2px); }
  .ft-body { padding: 64px var(--pad) 0; }
  .ft-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr); gap: 28px; align-items: start; }
  .ft-brand { align-self: stretch; display: flex; flex-direction: column; align-items: center; gap: 28px; padding-right: 56px; }
  .ft-brand-in { width: fit-content; max-width: 100%; }
  .ft-name { font-family: var(--stencil); font-weight: 400; font-size: 34px; letter-spacing: .06em; line-height: .78; filter: drop-shadow(0 0 14px rgba(227,178,60,.55)); white-space: nowrap; }
  .ft-tag { display: flex; justify-content: space-between; gap: 6px; white-space: nowrap; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; color: var(--faint); margin-top: 14px; }
  .ft-logo { width: 190px; height: 190px; flex: none; margin: 26px auto 0; transform: translateX(.06em); border-radius: 50%; overflow: hidden; position: relative; box-shadow: 0 0 24px rgba(227,178,60,.4); }
  .ft-logo :global(img) { position: absolute; left: -4.39%; top: -3.72%; width: 110%; height: 111.2%; max-width: none; }
  .ft-h { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; font-weight: 500; color: var(--gold); padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .ft-links { display: grid; grid-template-columns: 1fr; gap: 12px 24px; margin-top: 16px; }
  .ft-links a { font-size: 14px; line-height: 1.4; color: var(--text-2); transition: color .2s; }
  .ft-links a:hover, .ft-acc-links a:hover { color: var(--gold); }
  .ft-bar { max-width: 1400px; margin: 36px auto 0; padding-top: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 16px 32px; flex-wrap: wrap; }
  .ft-bar p, .ft-def-m { font-size: 13px; line-height: 1.5; color: var(--muted); }
  .ft-bar p a, .ft-def-m a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .ft-bar p a:hover, .ft-def-m a:hover { color: var(--gold-hover); }
  .ft-arr { display: inline-block; white-space: nowrap; max-width: 100%; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; line-height: 1.2; color: var(--gold); border: 1px solid var(--gold); padding: 12px 18px; }
  .ft-arr:hover { background: var(--gold-grad); background-size: 230% auto; color: var(--ink); }
  .ft-copy { max-width: 1400px; margin: 48px auto 0; display: flex; justify-content: center; text-align: center; padding: 20px 0; border-top: 1px solid var(--border); }
  .ft-copy span { font-family: var(--mono); font-size: 10px; letter-spacing: .16em; line-height: 1.8; color: var(--muted-2); }
  @media (max-width: 1023px) {
    .ft { padding-bottom: 70px; }
    .ft-soc-in { justify-content: center; }
    .ft-seg { font-size: 14px; }
    .ft-icons { gap: 10px; }
    .ft-body { padding-top: 34px; }
    .ft-mtop { display: flex; flex-direction: column; align-items: center; }
    .ft-logo-m { width: 128px; height: 128px; margin: 0 auto 22px; transform: none; }
    .ft-name { font-size: min(30px, 7.6vw); line-height: 1; }
    .ft-tag { font-size: min(11px, 2.8vw); margin-top: 12px; }
    .ft-acc { margin-top: 40px; border-top: 1px solid var(--border); }
    .ft-acc details { border-bottom: 1px solid var(--border); }
    .ft-acc summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; font-family: var(--mono); font-size: 12px; letter-spacing: .2em; font-weight: 500; color: var(--gold); }
    .ft-acc summary span { font-size: 16px; }
    .ft-acc-links { display: flex; flex-direction: column; gap: 16px; padding: 4px 0 24px; }
    .ft-acc-links a { font-size: 15px; line-height: 1.4; color: var(--text-2); }
    .ft-arr-m { display: block; width: 100%; text-align: center; margin-top: 28px; padding: 16px 18px; }
    .ft-def-m { margin-top: 16px; line-height: 1.6; text-align: center; }
    .ft-copy { margin-top: 26px; }
  }
</style>
